[Unit]
Description=NetzipRs native Rust full-market publisher to quoteGateway
Requires=netzip-rs.service quoteGateway.service
After=network-online.target netzip-rs.service quoteGateway.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/bin/netzip
EnvironmentFile=-/etc/default/netzip-rs
ExecStart=/home/bin/netzip/run-full-push.sh
Restart=always
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
